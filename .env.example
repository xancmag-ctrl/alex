# Supabase (Project Settings → API). Use SOMENTE a chave "anon"/"publishable".
# Nunca coloque a service_role key aqui: tudo que começa com VITE_ vai para o navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# Contato exibido em Perfil → Suporte (e-mail ou URL, ex.: https://wa.me/55...)
VITE_SUPPORT_CONTACT=suporte@seudominio.com.br
